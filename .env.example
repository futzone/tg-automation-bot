# BotFather'dan olingan token (Business Mode yoqilgan bo'lsin)
BOT_TOKEN=

# Sizning Telegram ID'ingiz (@userinfobot dan bilib oling)
OWNER_ID=

# Bot javoblarda sizni qanday atashi
OWNER_NAME=Zamon

# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Tez va arzon model. Murakkabroq javoblar uchun: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-haiku-5-5
MAX_TOKENS=2000

# Har bir chatdan nechta oxirgi xabar kontekst sifatida yuboriladi
HISTORY_LIMIT=20

# Siz qo'lda yozganingizdan keyin bot shu chatda necha daqiqa jim turadi
PAUSE_MINUTES=30

# Bitta chatga RATE_LIMIT_MINUTES daqiqa ichida ko'pi bilan RATE_LIMIT_COUNT ta AI javob.
# Limit tugasa, AI o'rniga RATE_LIMIT_MESSAGE yuboriladi (bo'sh bo'lsa standart matn).
RATE_LIMIT_COUNT=5
RATE_LIMIT_MINUTES=10
RATE_LIMIT_MESSAGE=

# Suhbatdosh ketma-ket yozsa, javobdan oldin necha soniya kutish
DEBOUNCE_SECONDS=4

TIMEZONE=Asia/Tashkent

# true bo'lsa, har bir avtomatik javob nusxasi sizga botda yuboriladi
REPORT_EVERY_REPLY=false

DB_PATH=data/bot.db
